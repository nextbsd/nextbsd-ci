2026-10-03T11:55:14.3932317Z === DBG: context around the suite expect
2026-10-03T11:55:14.3935578Z     # Do NOT match a prompt: automatic login lands early, with driver attach
2026-10-03T11:55:14.3936504Z     # messages still arriving, so the prompt is often not the last thing in the
2026-10-03T11:55:14.3937259Z     # buffer. Ask for a marker instead; characters typed before the shell is
2026-10-03T11:55:14.3937661Z     # ready are buffered by the tty.
2026-10-03T11:55:14.3937965Z     send "\r"
2026-10-03T11:55:14.3938301Z     send "echo NB-SHELL-READY\r"
2026-10-03T11:55:14.3938730Z     expect {
2026-10-03T11:55:14.3939056Z         timeout {
2026-10-03T11:55:14.3939512Z             puts "\nFAIL: no shell response after automatic login"
2026-10-03T11:55:14.3940411Z             exit 1
2026-10-03T11:55:14.3940755Z         }
2026-10-03T11:55:14.3941207Z         "NB-SHELL-READY" { puts "\nOK: shell is responding" }
2026-10-03T11:55:14.3941762Z     }
2026-10-03T11:55:14.3942068Z }
2026-10-03T11:55:14.3942552Z # admin is not root (and on the Apple image root is disabled), so wrap the
2026-10-03T11:55:14.3943433Z # privileged commands rather than repeating the test at each one. A function,
2026-10-03T11:55:14.3944266Z # so it behaves the same in sh and in zsh, which is admin's shell.
2026-10-03T11:55:14.3945000Z send "r() { if \[ \"\$(id -u)\" = 0 \]; then \"\$@\"; else sudo \"\$@\"; fi; }\r"
