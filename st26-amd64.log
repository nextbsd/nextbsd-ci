2026-10-03T12:06:34.8405464Z } else {
2026-10-03T12:06:34.8405951Z     # Do NOT match a prompt: automatic login lands early, with driver attach
2026-10-03T12:06:34.8407027Z     # messages still arriving, so the prompt is often not the last thing in the
2026-10-03T12:06:34.8407860Z     # buffer. Ask for a marker instead; characters typed before the shell is
2026-10-03T12:06:34.8408497Z     # ready are buffered by the tty.
2026-10-03T12:06:34.8408916Z     send "\r"
2026-10-03T12:06:34.8409259Z     send "echo NB-SHELL-READY\r"
2026-10-03T12:06:34.8409534Z     expect {
2026-10-03T12:06:34.8409719Z         timeout {
2026-10-03T12:06:34.8409977Z             puts "\nFAIL: no shell response after automatic login"
2026-10-03T12:06:34.8410290Z             exit 1
2026-10-03T12:06:34.8410474Z         }
2026-10-03T12:06:34.8410718Z         "NB-SHELL-READY" { puts "\nOK: shell is responding" }
2026-10-03T12:06:34.8411014Z     }
2026-10-03T12:06:34.8411186Z }
