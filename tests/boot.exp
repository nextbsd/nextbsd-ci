set nb_pol(SUDO) "must-pass"
set nb_reason(SUDO) "T3 must-pass: sudo ships in the image (the \"image predates base sudo\" escape is obsolete on self-assembled images); verified OK both arches 2026-10. Was: fork warned on absence."
set nb_owner(SYSCMD-LEAF) "nextbsd-freebsd-compat"
set nb_pol(SYSCMD-LEAF) "must-pass"
set nb_reason(SYSCMD-LEAF) "pending T3 audit; live arms: monolith t=fail/f=fail/s=continue"
set nb_owner(SYSLOG-RUN) "nextbsd-userland"
set nb_pol(SYSLOG-RUN) "must-pass"
set nb_reason(SYSLOG-RUN) "pending T3 audit; live arms: monolith t=fail/f=fail/s=continue ; fork t=fail/f=fail/s=continue"
