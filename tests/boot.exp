    puts "\nDBG: markers recorded: [llength [array names nb_seen]]"
    foreach m [lrange $nb_dbgmarks 0 7] {
        puts "\nDBG-MARK: <$m> at OK/SKIP/FAIL = [string first $m-OK $dbgfull]/[string first $m-SKIP $dbgfull]/[string first $m-FAIL $dbgfull]"
    }
