# patterns.tcl — the serial-stream regexes, in one place.
#
# Sourced first by every harness .exp.inc file, and independently by
# selftest/regex-golden.exp, so the golden test asserts on exactly the
# patterns the harness matches. If a pattern must change, it changes here,
# once, and the golden test re-proves it against production stream samples.
#
# Provenance: the loader/banner/login/teardown patterns are the strings the
# five diverged copies carried (nextbsd/tests/loader.exp.inc,
# nextbsd-userland/tests/boot-test.sh). Every pattern is brace-quoted with
# explicit character classes, so it compiles the same under any Tcl
# double-quote backslash behavior: the production runners match the
# double-quoted forms, and the selftest (same runners) re-proves the
# brace forms against the same stream shapes.
#
# re_summary is new (the T1 sentinel contract).

# The loader's autoboot countdown line (EDK2) and its UEFI self-identification.
# Brand-agnostic: the kernel rebranded ostype to NextBSD; the UEFI loader may
# still say FreeBSD. Matched, neither a rebrand nor a rename breaks the handshake.
set re_hit_enter  {Hit \[Enter\]}
set re_efi_banner {[A-Za-z]*BSD/[A-Za-z0-9._-]+ EFI}

# The loader's console report, printed right after it reads /efi/freebsd/
# loader.env ("   Console: efi (0x20000000)"). `comconsole` here is the proof
# the harness-written loader.env was applied (harness/loader-env.sh), so the
# loader can autoboot with no keystrokes; `efi` means it was not.
set re_loader_console {Console: ([a-z]+)[ ,(]}

# getty's boot banner: "<ostype>/<machine> (HOSTNAME) (console)". The
# hostname is captured for the BOOT-BANNER marker (the early-init race,
# nextbsd#325).
set re_boot_banner {[A-Za-z]*BSD/[A-Za-z0-9_]+ \(([A-Za-z0-9._-]+)\) \(console\)}
set re_early_init  {early-init: sethostname\('([^']+)'\)}

# login(1)'s session message (a syslog line that only reaches the console when
# syslogd is unreachable — nextbsd-userland#289) and the shell prompt.
set re_session_msg  {login on console as ([a-z_][a-z0-9_.-]*)}
set re_shell_prompt {[#%$] $}

# nextbsd-fetch(1) login banner (nextbsd-userland#298): "Welcome to NextBSD!".
# Run from /etc/zprofile at login, so it prints INSIDE the shell after the
# autologin -- proof the shell is alive. On the console it is ANSI-coloured
# (ESC[1;97m ... ESC[0m), so match the bare text; the wrappers are inert.
# Gated off where a desktop login window answers first, but the CI images are
# headless-console, so this always prints after a clean login.
set re_fetch_banner {Welcome to NextBSD!}

# The panic family, and the loader's "we are leaving the prompt" signals.
# `panic:` carries the colon: a real kernel panic prints "panic: <reason>",
# but on-image suites print the bare word in a PASS result ("...no panic
# under 2s") and a bare `panic` would false-fire on it. `Fatal trap` /
# `Fatal data abort` are already specific enough to leave alone.
set re_panic   {panic:|Fatal trap|Fatal data abort}
set re_boot_go {Booting|/boot/kernel/kernel|Loading kernel|---<<}
# A `boot` the loader could not carry out. Seen when the UART dropped the `-`
# of `boot -v`: the loader took `v` as a kernel name, printed `Loading
# kernel...` (which re_boot_go matches) and then gave up back at the prompt
# (nextbsd-kernel job 128521056625).
set re_boot_fail {Failed to load kernel|can't load 'kernel'}

# Teardown: shutdown(8) progress markers, the poweroff line, the reboot line.
set re_shutdown_wait {Waiting \(max [0-9]+ seconds\)|Syncing disks|All buffers synced|Uptime:}
set re_poweroff      {Powering system off}
set re_reboot        {Rebooting|rebooting}

# The sentinel (T1): one aggregate line per on-image suite.
set re_summary {NEXTBSD-TEST-SUMMARY ok=([0-9]+) fail=([0-9]+) skip=([0-9]+)}

# A capability marker line (T1): "<NAME>-<OK|SKIP|FAIL>".
# Matched by ONE arm PER SUFFIX plus a runtime policy table (nb_pol/nb_reason):
# the runners' expect takes the first arm in file order that matches ANYWHERE
# in the buffer, so 93 sorted per-marker arms let a marker whose text arrives
# late in the stream match first and consume every marker in between. And this
# expect does not populate expect_out(string) / expect_out(2,string) for the
# single-alternation marker pattern, so the marker name must be group 1 and the
# suffix is fixed per arm. The line-end tail stays out of the pattern: a
# (\\r\\n|\\n) tail group makes the arm never match in this expect, even
# though the same pattern matches under plain regexp (the golden proves it).
set re_marker_ok   {([A-Z0-9][A-Z0-9-]*)-OK}
set re_marker_fail {([A-Z0-9][A-Z0-9-]*)-FAIL}
set re_marker_skip {([A-Z0-9][A-Z0-9-]*)-SKIP}
# spawn.exp.inc — the expect skeleton: spawn the guest exactly as qemu-arch.sh
# describes it (binary, machine, firmware, accel, CPUs, NIC, video) with a serial
# console on stdio, a log file, and -no-reboot so a clean halt exits.
#
# Env (set by harness/boot-test.sh; the per-arch shape by qemu-arch.sh):
#   NB_LOG        serial transcript path (log_file -a)
#   NB_MEDIA      disk (default) | cd — which attached media boots the guest
#   NB_QEMU_ARGV  selftest override: full replacement argv for spawn
# The 8-minute budget: a TCG arm64 boot is slow, and the banner block (the
# first thing to see the kernel) must live through it. NB_TIMEOUT_GLOBAL
# shrinks it for the selftest so a broken arm fails in seconds, not 8 minutes.
if {[info exists env(NB_TIMEOUT_GLOBAL)] && $env(NB_TIMEOUT_GLOBAL) ne ""} {
    set timeout [expr {$env(NB_TIMEOUT_GLOBAL) + 0}]
} else {
    set timeout 480
}
log_file -a $env(NB_LOG)
log_user 1

set accel_flags [split $env(ACCEL_FLAGS) " "]
set smp_args    [split $env(SMP_ARGS) " "]
set net_args    [split $env(NET_ARGS) " "]
set video_args  [split $env(VIDEO_ARGS) " "]
set disk_args   [split $env(DISK_ARGS) " "]
set cd_args     [split $env(CD_ARGS) " "]
# NB_MEDIA=cd is the live-ISO shape (virt has no IDE: the ISO must ride the
# virtio-scsi CD); everything else boots the virtio disk.
if {[info exists env(NB_MEDIA)] && $env(NB_MEDIA) eq "cd"} {
    set media_args $cd_args
} else {
    set media_args $disk_args
}

if {[info exists env(NB_QEMU_ARGV)] && $env(NB_QEMU_ARGV) ne ""} {
    # selftest: a fake guest stands in for qemu
    set spawn_args [split $env(NB_QEMU_ARGV) " "]
} else {
    set spawn_args [concat [list $env(QEMU) -m 4G -machine $env(MACHINE) -bios $env(FW)] \
                           $accel_flags $smp_args $media_args $net_args $video_args \
                           [list -display none -serial stdio -no-reboot]]
}
eval spawn $spawn_args
# loader.exp.inc — the FreeBSD loader serial handshake, shared by every NextBSD
# boot harness. `source harness/loader.exp.inc` immediately after the guest
# spawn, then: nb_loader_contract (harness/contract.exp.inc) does the rest.
#
# Migrated from nextbsd/tests/loader.exp.inc, which was lifted from
# nextbsd-userland's tests/boot-test.sh, which hardened it over several flaky
# runs. The emulated UART (16550 on q35, pl011 on virt) drops the odd
# character in BOTH directions, so:
#   - input is paced at ~25 cps (send -s) rather than dumped at once;
#   - each command syncs on the loader's next "OK " prompt, never on the echo of
#     what we typed (run 26070245676 showed `boot_multicons` echoed back as
#     `boo_multicons` on a command the loader had in fact accepted);
#   - the final `boot` is re-sent if the loader rejects it, because a garbled
#     boot never self-recovers — it just sits at the prompt (run 28754808354).

# ~25 cps: brisk-typist cadence, slow enough for the UART to keep up.
set send_slow {1 .04}

# loader_autoboot <secs> — the no-typing path (NB_LOADER_ENV=1): the contract
# is already in the loader's environment from the ESP's loader.env
# (harness/loader-env.sh), so send NOTHING and let autoboot_delay run out.
# Returns 1 once the loader reports `Console: comconsole` (the file was read
# and applied), 0 if it reports any other console (the file was not applied:
# the caller types the contract instead, and the countdown it interrupts is
# still ahead in the stream).
proc loader_autoboot {secs} {
    global timeout re_loader_console
    set saved $timeout
    set timeout $secs
    expect {
        timeout { puts "\nFAIL: the loader never reported its console within ${secs}s"; exit 1 }
        -re $re_loader_console {
            set con $expect_out(1,string)
        }
    }
    set timeout $saved
    if {$con eq "comconsole"} {
        puts "\n==> loader.env applied (console=comconsole, boot_verbose=YES); autobooting, nothing typed"
        return 1
    }
    puts "\n==> loader reports console '$con', so loader.env was not applied; typing the contract"
    return 0
}

# loader_prompt <secs> — catch the autoboot countdown and stop at the OK prompt.
# Under -display none the loader's default `efi` console routes to serial on both
# arches, so the banner and the prompt come to us over -serial stdio. The EFI
# banner line is matched brand-agnostically: the ostype is NextBSD after the
# kernel rebrand, and neither a rebrand nor a new brand may break the handshake.
proc loader_prompt {secs} {
    global timeout re_hit_enter re_efi_banner
    set saved $timeout
    set timeout $secs
    expect {
        timeout { puts "\nFAIL: didn't see the loader autoboot prompt within ${secs}s"; exit 1 }
        -re $re_hit_enter  { send " " }
        "Booting"          { send " " }
        -re $re_efi_banner { send " " }
        "Loading /boot/loader" { send " " }
    }
    set timeout 30
    expect {
        timeout { puts "\nFAIL: didn't reach the loader OK prompt within 30s"; exit 1 }
        "OK " { puts "\n==> at loader prompt" }
    }
    set timeout $saved
}

# loader_set <cmd> — set one loader variable, robustly.
#   1. settle at the prompt (the loader is still printing when it first appears)
#   2. drain, so we can't latch the PREVIOUS command's OK
#   3. send paced
#   4. sync on the fresh OK
proc loader_set {cmd} {
    global timeout
    set saved $timeout
    set timeout 20
    sleep 0.3
    expect *
    send -s -- "$cmd\r"
    expect {
        timeout { puts "\nFAIL: no OK prompt after '$cmd' within 20s"; exit 1 }
        "OK "
    }
    set timeout $saved
}

# loader_boot <cmd> — issue the final boot command, retrying a garbled send.
# Success = the loader leaves the prompt to load the kernel: no "unknown
# command", no failed kernel load, and no fresh "OK " inside the settle window.
# `Loading kernel...` alone is not success: a `boot v` (dropped dash) prints it
# too, then "Failed to load kernel 'v'" and drops back to the prompt — so a
# boot-go line is confirmed against a short follow-up window first. The retry
# then reloads the default kernel, which the failed load unloaded.
proc loader_boot {cmd} {
    global timeout re_boot_go re_boot_fail
    set saved $timeout
    set timeout 10
    for {set try 1} {$try <= 5} {incr try} {
        sleep 0.3
        expect *
        send -s -- "$cmd\r"
        expect {
            "unknown command" {
                puts "\n==> loader garbled '$cmd' (try $try/5); resending"
                continue
            }
            -re $re_boot_fail {
                puts "\n==> loader could not boot after '$cmd' (garbled; try $try/5); resending"
                continue
            }
            -re $re_boot_go {
                if {[string match "---<<*" $expect_out(0,string)]} {
                    set timeout $saved
                    return
                }
                set timeout 3
                expect {
                    -re $re_boot_fail {
                        set timeout 10
                        puts "\n==> loader could not boot after '$cmd' (garbled; try $try/5); resending"
                        continue
                    }
                    -ex "---<<" { }
                    timeout { }
                }
                set timeout $saved
                return
            }
            "OK " {
                puts "\n==> loader still at prompt after '$cmd' (try $try/5); resending"
                continue
            }
            timeout {
                # No reject and no fresh prompt => the kernel is loading.
                set timeout $saved
                return
            }
        }
    }
    puts "\nFAIL: loader never accepted '$cmd' after 5 tries (UART input drop)"
    exit 1
}
# contract.exp.inc — THE loader contract. One place, every arch, every lane.
# (nextbsd-ci T1; "verbose at the loader, never baked into images".)
#
#   console=comconsole       CI runs with -display none; serial is the console
#   boot_serial=YES          the kernel prints to it
#   comconsole_speed=115200  the cadence the -serial stdio pipe assumes
#   boot_multicons=YES       keep the (absent) vidconsole slot quiet as well
#   boot_mutemsgs=NO         undo the shipped quiet console (overlays#363). The
#                            shipped image stays macOS-clean; CI needs the kernel
#                            messages, and the on-image markers ride the same line.
#                            `NO` (not `unset`) is deliberate: the loader's howto
#                            builder does `val != NULL && strcasecmp(val, "no") != 0`
#                            (sys/kern/subr_boot.c boot_env_to_howto), so `=NO`
#                            clears RB_MUTEMSGS while keeping the variable set.
#   boot -v                  RB_VERBOSE bypasses the mute in the kernel, so CI
#                            sees full boot output while shipped images stay quiet.
#                            This is the fix for the five-harness divergence:
#                            nextbsd's big boot-test.sh did a bare `boot`, the
#                            img/iso harnesses did `boot -v`, the userland fork
#                            did a bare `boot` — one answer now, in one place.
#
# mach.debug_enable / launchd_trace stay the NB_BOOT_TRACE=1-only opt-in
# (nextbsd#369): with the console un-muted, the trace points push thousands of
# blocking kernel printfs through the emulated UART, which buries the on-image
# test markers and perturbs timing-sensitive Mach handshakes. Set
# NB_BOOT_TRACE=1 for a root-cause run.
#
# How it gets there: NOT by typing, whenever the image allows it. Typed input
# crosses the emulated UART, which corrupts it once the loader is on
# comconsole — `boot -v` arrived as `boot v` (the loader went looking for a
# kernel named 'v' and the boot timed out at the banner), an Enter arrived as
# NUL (no OK prompt ever came back). So boot-test.sh writes these same
# variables to the disk image's ESP as /efi/freebsd/loader.env
# (harness/loader-env.sh), the loader applies them before loader.conf and
# autoboot, and NB_LOADER_ENV=1 tells this proc to send nothing at all.
# `boot_verbose=YES` there is `boot -v` (both set RB_VERBOSE). boot_mutemsgs is
# the one variable it can't override — loader.conf is read after loader.env and
# the image ships "YES" — and it doesn't need to: RB_VERBOSE exempts the boot
# from the mute, which is exactly how the image's own nextbsd.conf says CI gets
# its kernel output.
#
# The typed contract below stays for media with no writable ESP (the live
# ISO), for an image whose ESP write failed, and for a loader that reports a
# console other than comconsole (loader.env not applied).
#
# Requires: loader.exp.inc (loader_autoboot / loader_prompt / loader_set /
# loader_boot).
proc nb_loader_contract {} {
    global env
    if {[info exists env(NB_LOADER_ENV)] && $env(NB_LOADER_ENV) eq "1"} {
        if {[loader_autoboot 60]} {
            return
        }
    }
    loader_prompt 60
    loader_set "set console=comconsole"
    loader_set "set boot_serial=YES"
    loader_set "set comconsole_speed=115200"
    loader_set "set boot_multicons=YES"
    loader_set "set boot_mutemsgs=NO"
    if {[expr {[info exists env(NB_BOOT_TRACE)] && $env(NB_BOOT_TRACE) eq "1"}]} {
        puts "\n==> NB_BOOT_TRACE=1: enabling mach.debug_enable + launchd_trace"
        loader_set "set mach.debug_enable=1"
        loader_set "set launchd_trace=1"
    }
    loader_boot "boot -v"
}

# boot-test.sh cats spawn -> loader -> contract -> login; the contract runs
# here, so the login block below starts only after `boot -v` is accepted.
nb_loader_contract
# login.exp.inc — get a usable shell on the booted system.
#
# Banner: captured for the BOOT-BANNER manifest marker. getty's banner and
# hostnamed's synthesis race (launchd dispatches them in parallel): the
# first-boot banner consistently loses and shows 'Amnesiac', while kern.hostname
# is set correctly (HOSTNAMED-OK proves it downstream) and the second getty
# respawn shows the synthesized name. The verdict policy comes from the
# manifest (NB_BANNER_POLICY); a mismatch is RECORDED here and decided in
# suite-tail so the suite still runs in the meantime.
#
# Login: root is disabled the way Darwin does it (nextbsd-overlays f9dcd5b —
# the password field went from empty to "*"), so admin is the way in on the
# Apple image; the userland-native CI image still carries a live root, so a
# "Login incorrect" on admin falls back to root. Where automatic login is
# configured there is no prompt at all, so both paths are handled rather than
# assuming either.
#
# Exit 2 (not 1) for the "never got there" timeouts below: a boot that never
# completes is categorically different from an assertion that fails, and
# boot_soft must not hide it (nextbsd-userland#87/#117: an 8-minute hang once
# reported pass). Every consumer workflow re-gates on rc==2 regardless of
# boot_soft.

set early_name ""
set banner_fail ""
expect {
    timeout {
        puts "\nFAIL: boot banner not seen within $timeout s (the global budget)"
        exit 2
    }
    -re $re_panic {
        puts "\nFAIL: kernel panic during boot"
        exit 1
    }
    -re $re_early_init {
        set early_name $expect_out(1,string)
        exp_continue
    }
    -re $re_boot_banner {
        set banner_name $expect_out(1,string)
        if {$banner_name eq "Amnesiac" || $banner_name eq "localhost" || ($early_name ne "" && $banner_name ne $early_name)} {
            set banner_fail "banner shows '$banner_name' (early-init synthesized '$early_name')"
            puts "\nWARN: BOOT-BANNER — $banner_fail (recorded; decided after the suite)"
        } else {
            puts "\nOK: BOOT-BANNER-OK — getty shows the synthesized hostname '$banner_name'"
        }
    }
}

# Get a usable shell, in two stages.
#
# Stage 1 waits for the nextbsd-fetch login banner ("Welcome to NextBSD!",
# run from /etc/zprofile at login, so it prints INSIDE the shell after the
# autologin -- proof the shell is alive), or a login prompt / the session
# message on an image that does not autologin. The CI images are
# headless-console (no desktop login window), so nextbsd-fetch always prints
# after a clean login; it is the hard "shell is alive" gate.
#
# Stage 2 (below) waits for the shell prompt ([#%$] $) -- proof the shell is
# idle and accepting input, which the banner alone does not establish (it
# renders before the shell settles). The % only counts once the banner (or
# login) has been seen, so a stray driver line ending in % before the banner
# can't false-trigger it.
#
# The window is capped (180s) so a hung image bails quickly instead of waiting
# out the whole NB_TIMEOUT_GLOBAL. The "login on console as ..." session message
# is a syslog line that only reaches the console when syslogd is unreachable
# (a lost race on arm64, nextbsd-userland#289), so it is a secondary signal,
# not the gate.
set _saved_login_timeout $timeout
if {$timeout > 180} { set timeout 180 }
set at_login 1
expect {
    timeout {
        puts "\n... no login prompt and no session message; probing for a shell"
        send "\r"
        send "echo NB-SHELL-READY\r"
        expect {
            -timeout 90
            timeout {
                puts "\nFAIL: no 'login:' prompt, no session message, and no shell responded"
                exit 2
            }
            -re $re_panic {
                puts "\nFAIL: kernel panic during boot"
                exit 1
            }
            "NB-SHELL-READY" {
                set at_login 0
                puts "\nOK: automatic session confirmed by probe"
            }
        }
    }
    -re $re_panic {
        puts "\nFAIL: kernel panic during boot"
        exit 1
    }
    -re $re_fetch_banner {
        set at_login 0
        puts "\nOK: shell alive (nextbsd-fetch banner)"
    }
    "login:" { puts "\nOK: boot reached the login prompt" }
    -re $re_session_msg {
        set at_login 0
        puts "\nOK: boot logged in automatically as $expect_out(1,string)"
    }
}
set timeout $_saved_login_timeout

if {$at_login} {
    send "admin\r"
    expect {
        timeout {
            puts "\nFAIL: no response after sending admin"
            exit 1
        }
        "Login incorrect" {
            # The Apple image disabled root; the userland-native image allows it.
            send "root\r"
            expect {
                timeout {
                    puts "\nFAIL: no response after sending root"
                    exit 1
                }
                "Login incorrect" {
                    puts "\nFAIL: both admin and root logins rejected"
                    exit 1
                }
                "Password:" { send "\r"; exp_continue }
                -re $re_shell_prompt { puts "\nOK: at root shell prompt" }
            }
        }
        "Password:" { send "\r"; exp_continue }
        -re $re_shell_prompt { puts "\nOK: logged in as admin" }
    }
}
# Stage 2: the shell prompt (the shell is idle/ready). The % only counts once
# the fetch banner (or the login above) has already been seen, so a stray
# driver line ending in % before the banner can't false-trigger it. On timeout
# (the prompt never rendered), probe for a shell before concluding anything.
expect {
    timeout {
        send "\r"
        send "echo NB-SHELL-READY\r"
        expect {
            -timeout 90
            timeout {
                puts "\nFAIL: no shell prompt, and no shell responded to the probe"
                exit 2
            }
            -re $re_panic {
                puts "\nFAIL: kernel panic during boot"
                exit 1
            }
            "NB-SHELL-READY" {
                puts "\nOK: shell confirmed by probe"
            }
        }
    }
    -re $re_panic {
        puts "\nFAIL: kernel panic during boot"
        exit 1
    }
    -re $re_shell_prompt {
        puts "\nOK: shell prompt (idle/ready)"
    }
}
# admin is not root (and on the Apple image root is disabled), so wrap the
# privileged commands rather than repeating the test at each one. A function,
# so it behaves the same in sh and in zsh, which is admin's shell.
send "r() { if \[ \"\$(id -u)\" = 0 \]; then \"\$@\"; else sudo \"\$@\"; fi; }\r"
# generated by manifest/gen-arms.tcl — do not edit
# arch: amd64 | suites: 2 | manifest: /private/tmp/claude-501/-Users-jmaloney-Documents/eb4dc18a-6d01-42fd-933f-3a686a6cb663/scratchpad/nbci-boot/manifest/markers.tsv + /dev/null
