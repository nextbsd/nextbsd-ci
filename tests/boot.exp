set nb_reason(SC-RUNLOOP) "pending T3 audit; live arms: monolith t=fail/f=fail/s=continue ; fork t=fail/f=fail/s=continue"
set nb_owner(SC-STORE) "nextbsd-userland"
set nb_pol(SC-STORE) "must-pass"
set nb_reason(SC-STORE) "pending T3 audit; live arms: monolith t=fail/f=fail/s=continue ; fork t=fail/f=fail/s=continue"
