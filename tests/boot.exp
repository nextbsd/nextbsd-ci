            }
            set nb_wfail($m) 1
            puts "\nWARN: $m-FAIL — $r (informational)"
            exp_continue
        }
        if {$sfx eq "SKIP"} {
            if {$pol eq "must-pass"} {
                puts "\nFAIL: $m-SKIP — a must-pass capability self-skipped (absent from this image)"
                exit 1
            }
            set nb_seen($m) 1
            puts "\nWARN: $m-SKIP — $r"
            exp_continue
