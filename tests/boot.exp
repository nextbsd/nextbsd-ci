set nb_pol(SC-VLAN) "must-pass"
set nb_reason(SC-VLAN) "pending T3 audit; live arms: monolith t=fail/f=fail/s=continue ; fork t=fail/f=fail/s=continue"
set nb_owner(SERVICE-LDCONFIG) "nextbsd-userland"
set nb_pol(SERVICE-LDCONFIG) "must-pass"
set nb_reason(SERVICE-LDCONFIG) "pending T3 audit; live arms: fork t=fail/f=fail/s=continue"
set nb_owner(SHELLCMD-LEAF) "nextbsd-freebsd-compat"
set nb_pol(SHELLCMD-LEAF) "must-pass"
set nb_reason(SHELLCMD-LEAF) "pending T3 audit; live arms: monolith t=fail/f=fail/s=continue"
