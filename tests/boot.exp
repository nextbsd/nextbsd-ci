set nb_pol(WAITQUIET) "must-pass"
set nb_reason(WAITQUIET) "pending T3 audit; live arms: monolith t=fail/f=fail/s=continue ; fork t=fail/f=fail/s=continue"
set nb_owner(WEDGE-CHECK) "nextbsd-userland"
set nb_pol(WEDGE-CHECK) "must-pass"
set nb_reason(WEDGE-CHECK) "T3 must-pass: a wedged Mach service is a broken system (the 2026-08-30 incident this probe exists for); verified OK on all recent boots, both arches. Was: informational in the fork."

set timeout $env(NB_SUITE_TIMEOUT)
puts "==> running on-image suite: /usr/tests/freebsd-launchd-mach/run.sh"
send "r /usr/tests/freebsd-launchd-mach/run.sh\r"
expect {
    timeout {
        puts "\nFAIL: /usr/tests/freebsd-launchd-mach/run.sh printed no NEXTBSD-TEST-SUMMARY within the $env(NB_SUITE_TIMEOUT)s budget (no sentinel — the suite hung or died)"
        if {$env(NB_DEBUG) ne ""} {
            set fh [open $env(NB_LOG) r]
            set d [read $fh]
            close $fh
            set cmap [list "\r" {<CR>} "\n" {<NL>} "\t" {<TAB>}]
            set d2 [string range $d end-300 end]
            puts "\nDBG-TIMEOUT: transcript [string length $d] bytes; tail: [string map $cmap $d2]"
        }
        exit 2
    }
    -re $re_marker_ok {
        set m $expect_out(1,string)
        set sfx OK
        if {![info exists nb_pol($m)]} { if {$env(NB_DEBUG) ne ""} { puts "\nDBG-ARM: unlisted marker <$m>-$sfx — ignoring" }; exp_continue }
        set pol $nb_pol($m)
        set r   $nb_reason($m)
        if {$sfx eq "OK"} {
            set nb_seen($m) 1
            puts "\nOK: $m"
            exp_continue
        }
        if {$sfx eq "FAIL"} {
            if {$pol eq "must-pass" || $pol eq "fail-gates"} {
                puts "\nFAIL: $m — $r"
                exit 1
            }
            if {$pol eq "offarch"} {
                puts "\nINFO: $m-FAIL (not expected on amd64 — $r)"
                exp_continue
            }
            set nb_wfail($m) 1
            puts "\nWARN: $m-FAIL — $r (informational)"
            exp_continue
        }
        if {$sfx eq "SKIP"} {
            if {$pol eq "must-pass"} {
                puts "\nFAIL: $m-SKIP — a must-pass capability self-skipped (absent from this image)"
                exit 1
            }
            set nb_seen($m) 1
            puts "\nWARN: $m-SKIP — $r"
            exp_continue
        }
    }
    -re $re_marker_fail {
        set m $expect_out(1,string)
        set sfx FAIL
        if {![info exists nb_pol($m)]} { if {$env(NB_DEBUG) ne ""} { puts "\nDBG-ARM: unlisted marker <$m>-$sfx — ignoring" }; exp_continue }
        set pol $nb_pol($m)
        set r   $nb_reason($m)
        if {$sfx eq "OK"} {
            set nb_seen($m) 1
            puts "\nOK: $m"
            exp_continue
        }
        if {$sfx eq "FAIL"} {
            if {$pol eq "must-pass" || $pol eq "fail-gates"} {
                puts "\nFAIL: $m — $r"
                exit 1
            }
            if {$pol eq "offarch"} {
                puts "\nINFO: $m-FAIL (not expected on amd64 — $r)"
                exp_continue
            }
            set nb_wfail($m) 1
            puts "\nWARN: $m-FAIL — $r (informational)"
            exp_continue
        }
        if {$sfx eq "SKIP"} {
            if {$pol eq "must-pass"} {
                puts "\nFAIL: $m-SKIP — a must-pass capability self-skipped (absent from this image)"
                exit 1
            }
            set nb_seen($m) 1
            puts "\nWARN: $m-SKIP — $r"
            exp_continue
        }
    }
    -re $re_marker_skip {
        set m $expect_out(1,string)
        set sfx SKIP
        if {![info exists nb_pol($m)]} { if {$env(NB_DEBUG) ne ""} { puts "\nDBG-ARM: unlisted marker <$m>-$sfx — ignoring" }; exp_continue }
        set pol $nb_pol($m)
        set r   $nb_reason($m)
        if {$sfx eq "OK"} {
            set nb_seen($m) 1
            puts "\nOK: $m"
            exp_continue
        }
        if {$sfx eq "FAIL"} {
            if {$pol eq "must-pass" || $pol eq "fail-gates"} {
                puts "\nFAIL: $m — $r"
                exit 1
            }
            if {$pol eq "offarch"} {
                puts "\nINFO: $m-FAIL (not expected on amd64 — $r)"
                exp_continue
            }
            set nb_wfail($m) 1
            puts "\nWARN: $m-FAIL — $r (informational)"
            exp_continue
        }
        if {$sfx eq "SKIP"} {
            if {$pol eq "must-pass"} {
                puts "\nFAIL: $m-SKIP — a must-pass capability self-skipped (absent from this image)"
                exit 1
            }
            set nb_seen($m) 1
            puts "\nWARN: $m-SKIP — $r"
            exp_continue
        }
    }
    -re $re_summary {
        set nb_ok   $expect_out(1,string)
        set nb_fail $expect_out(2,string)
        set nb_skip $expect_out(3,string)
        set nb_warnfail_sum 0
        foreach w $nb_warnfail {
            if {[info exists nb_wfail($w)]} { incr nb_warnfail_sum }
        }
        if {$nb_fail > $nb_warnfail_sum} {
            puts "\nFAIL: /usr/tests/freebsd-launchd-mach/run.sh: NEXTBSD-TEST-SUMMARY ok=$nb_ok fail=$nb_fail skip=$nb_skip — the suite's own verdict is a failure"
            exit 1
        }
        if {$nb_fail > 0} {
            puts "\nOK: /usr/tests/freebsd-launchd-mach/run.sh: NEXTBSD-TEST-SUMMARY ok=$nb_ok fail=$nb_fail skip=$nb_skip ($nb_fail failure(s) are manifest-warn class; not gated)"
        } else {
            puts "\nOK: /usr/tests/freebsd-launchd-mach/run.sh: NEXTBSD-TEST-SUMMARY ok=$nb_ok fail=0 skip=$nb_skip"
        }
    }
    -re $re_panic {
        puts "\nFAIL: kernel panic during /usr/tests/freebsd-launchd-mach/run.sh"
        exit 1
    }
    eof {
        puts "\nFAIL: /usr/tests/freebsd-launchd-mach/run.sh died (serial stream closed) before printing NEXTBSD-TEST-SUMMARY"
        if {$env(NB_DEBUG) ne ""} {
            set fh [open $env(NB_LOG) r]
            set d [read $fh]
            close $fh
            set cmap [list "\r" {<CR>} "\n" {<NL>} "\t" {<TAB>}]
            set d2 [string range $d end-300 end]
            puts "\nDBG-EOF: transcript [string length $d] bytes; tail: [string map $cmap $d2]"
        }
        exit 2
    }
}
if {$env(NB_DEBUG) ne ""} {
    set dbgfull ""
    if {[file exists $env(NB_LOG)]} {
        set fh [open $env(NB_LOG) r]
        set dbgfull [read $fh]
        close $fh
    }
    set cmap [list "\r" {<CR>} "\n" {<NL>} "\t" {<TAB>}]
    set d2 [string range $dbgfull end-300 end]
    puts "\nDBG: transcript [string length $dbgfull] bytes; tail: [string map $cmap $d2]"
    puts "\nDBG: markers recorded: [llength [array names nb_seen]]"
    foreach m [lrange $nb_dbgmarks 0 7] {
        puts "\nDBG-MARK: <$m> at OK/SKIP/FAIL = [string first $m-OK $dbgfull]/[string first $m-SKIP $dbgfull]/[string first $m-FAIL $dbgfull]"
    }
}

set timeout $env(NB_SUITE_TIMEOUT)
puts "==> running on-image suite: /usr/tests/nextbsd-iokit/run.sh"
