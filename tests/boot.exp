# the suite section is done; suite-tail.exp.inc takes over (absence check,
# banner verdict, end-state) and teardown.exp.inc the poweroff.
# suite-tail.exp.inc — what runs after the per-suite sentinel blocks close:
# the must-pass absence check, the recorded banner verdict, and the final
# end-state confirmation, before any PASS can be printed.
#
# The absence check is the "a must-pass marker that didn't emit fails the
# lane" half of the protocol: the summary arm proved the suite completed
# (and that its own aggregate verdict was green), so a must-pass marker that
# never appeared was never run — an image that predates the capability, or a
# suite that quietly skipped it. Consumers that boot older continuous images
# declare the tolerance in their overlay (warn), which removes the marker
# from this check.

# The absence check applies only when a suite actually ran. A login-only boot
# (NB_LOGIN_ONLY, no on-image suite) has no markers to require, so a must-pass
# marker that never appeared is expected there, not a failure.
if {[info exists nb_suites_ran] && $nb_suites_ran > 0} {
    set nb_missing 0
    foreach m $nb_mustpass {
        if {![info exists nb_seen($m)]} {
            if {$nb_scope eq "any" || [expr {[llength $nb_scope] > 0 && [lsearch -exact $nb_scope [set nb_owner($m)]] >= 0}]} {
                puts "\nFAIL: $m — must-pass marker never emitted (suite did not reach it, or the image predates the capability; overlay to warn if that is expected)"
                incr nb_missing
            } else {
                puts "\nINFO: $m — must-pass but owned by [set nb_owner($m)]; no running suite owns it, so it is out of scope for this boot"
            }
        }
    }
    if {$nb_missing > 0} {
        puts "\nFAIL: $nb_missing must-pass marker(s) missing from the suite output"
        exit 1
    }
} else {
    puts "\nOK: login-only boot (no on-image suite) — skipping the must-pass absence check"
}

if {[info exists banner_fail] && $banner_fail ne ""} {
    if {$env(NB_BANNER_POLICY) eq "must-pass"} {
        puts "\nFAIL: BOOT-BANNER — $banner_fail"
        exit 1
    }
    puts "\nWARN: BOOT-BANNER — $banner_fail (informational per manifest)"
}

# Final end-state (nextbsd#428): a PASS at the login prompt is not a PASS if
# the system resets seconds later. After the suite, before any PASS, the shell
# must still answer. A lost end-state is the hang class: exit 2.
if {[info exists env(NB_TIMEOUT_GLOBAL)] && $env(NB_TIMEOUT_GLOBAL) ne ""} {
    set timeout [expr {$env(NB_TIMEOUT_GLOBAL) + 0}]
} else {
    set timeout 60
}
send "\r"
send "echo NB-END-STATE\r"
expect {
    timeout {
        puts "\nFAIL: shell did not answer after the suite — end-state lost (the nextbsd#428 class); no PASS"
        exit 2
    }
    -re $re_panic {
        puts "\nFAIL: kernel panic in the end-state window"
        exit 1
    }
    "NB-END-STATE" { puts "\nOK: shell alive after the suite" }
    -re {[#%$] $} { puts "\nOK: shell alive after the suite" }
}

# #428 end-state HOLD: a single probe is not a stability proof. The class this
# ticket names is a system that answers the probe fine, then resets seconds
# later -- after the harness has already committed to a PASS and is tearing
# down. So hold the console for a bounded window: heartbeat the shell (proof
# it is still the same live session), then watch for the reset signals (a
# fresh getty banner, a reboot line, a panic, or the console dying). Any of
# them means the end-state was not real -> the hang class, exit 2 (a panic is
# exit 1). The window is capped by the remaining global budget so it can never
# push a boot past its own timeout.
set _saved_hold_timeout $timeout
set _hold 15
if {$timeout < $_hold} { set _hold $timeout }
set _hb 0
set timeout [expr {$_hold / 2}]
send "echo NB-HOLD\r"
expect {
    timeout { set _hb 0 }
    -re $re_reboot      { puts "\nFAIL: system rebooted during the end-state hold (nextbsd#428)"; exit 2 }
    -re $re_panic       { puts "\nFAIL: kernel panic during the end-state hold (nextbsd#428)"; exit 1 }
    -re $re_boot_banner { puts "\nFAIL: a fresh getty banner during the end-state hold — the system reset (nextbsd#428)"; exit 2 }
    eof                 { puts "\nFAIL: the console died during the end-state hold (nextbsd#428)"; exit 2 }
    "NB-HOLD"           { set _hb 1 }
}
set timeout [expr {$_hold / 2}]
if {$_hb} {
    expect {
        timeout { puts "\nOK: end-state held for ${_hold}s — shell alive, no reset (nextbsd#428)" }
        -re $re_reboot      { puts "\nFAIL: system rebooted after the end-state heartbeat (nextbsd#428)"; exit 2 }
        -re $re_panic       { puts "\nFAIL: kernel panic after the end-state heartbeat (nextbsd#428)"; exit 1 }
        -re $re_boot_banner { puts "\nFAIL: a fresh getty banner after the end-state heartbeat — the system reset (nextbsd#428)"; exit 2 }
        eof                 { puts "\nFAIL: the console died after the end-state heartbeat (nextbsd#428)"; exit 2 }
    }
} else {
    puts "\nWARN: no end-state heartbeat (the probe above passed; shell may be wedged) — proceeding to teardown"
}
set timeout $_saved_hold_timeout
# teardown.exp.inc — power off THROUGH launchd, and verify it happened.
#
# Ported from nextbsd-userland's tests/boot-test.sh, the most hardened of the
# five diverged copies. `shutdown -p now` signals PID 1 with SIGUSR2 per the
# BSD init(8) protocol, so this stage gates nextbsd#398 (the pre-fix launchd
# treated SIGUSR2 as a debug-log toggle and the system stalled forever after
# "System shutdown time has arrived").
#
# Discriminators, because -no-reboot makes qemu exit on EITHER outcome:
#   "Powering system off"  = RB_POWEROFF honored  -> SHUTDOWN-P-OK
#   "Rebooting"            = wrong reboot_flags   -> FAIL (exit 1)
#   timeout                = the #398 stall        -> FAIL, then halt -p
#                           (bypasses init, so the runner is never left
#                            hanging; still exit 1)
#
# nextbsd#503: the command's exit status is captured via the NB-SHUTDOWN-RC
# sentinel (appended with `; echo ... $?`). A shutdown that SUCCEEDS powers
# the VM off and the sentinel never prints, so the sentinel appears only on
# the "returned early without powering off" path -- the datum the ticket asked
# for (a silent non-zero was previously invisible). Seeing the banner but qemu
# not exiting within the budget is now a hard FAIL, not an informational WARN.
#
# Two things historically made this stage fail intermittently, and neither was
# a stall in launchd:
#   1. The poweroff was timed from when the command went out rather than from
#      the last sign of life, so a slow-but-working shutdown could trip the
#      budget (vnlru and syncer are each granted "max 60 seconds" to stop).
#      Progress markers reset the clock, which still catches a genuine stall
#      (no output at all).
#   2. The poweroff was sent without waiting for a shell prompt. The previous
#      block can leave the rest of its line and the prompt unconsumed, and
#      sending into that races the tty: zsh sees an empty line, prints a fresh
#      prompt, and `shutdown` never runs at all. So synchronise on a sentinel
#      first, then send.

send "\r"
send "echo NB-PRE'-'SHUTDOWN\r"
expect {
    timeout           { puts "\nWARN: no prompt before poweroff; sending anyway" }
    "NB-PRE-SHUTDOWN" { exp_continue }
    -re {[#%$] $}     { }
}

send "r shutdown -p now; echo NB-SHUTDOWN-RC=\$?\r"
set timeout 180
set shutdown_progress 0
set shutdown_rc ""
expect {
    -re $re_shutdown_wait {
        set shutdown_progress 1
        exp_continue
    }
    -re {NB-SHUTDOWN-RC=([0-9]+)} {
        set shutdown_rc $expect_out(1,string)
        set shutdown_progress 1
        puts "\nNOTE: shutdown -p returned early (rc=$shutdown_rc) without powering off (the nextbsd#503 class); watching for a late poweroff"
        exp_continue
    }
    timeout {
        if {$shutdown_rc ne ""} {
            puts "\nFAIL: SHUTDOWN-P — shutdown -p returned early (rc=$shutdown_rc) and the system never powered off within 180s (nextbsd#503)"
        } elseif {$shutdown_progress} {
            puts "\nFAIL: SHUTDOWN-P — shutdown was progressing but produced nothing for 180s and never powered off"
        } else {
            puts "\nFAIL: SHUTDOWN-P — no response at all within 180s of shutdown -p (init-protocol stall; this is what nextbsd#398 was)"
        }
        send "\r"
        sleep 1
        send "r halt -p\r"
        expect { timeout {} eof {} "Uptime:" {} }
        catch { close }
        catch { wait }
        exit 1
    }
    -re $re_reboot {
        puts "\nFAIL: SHUTDOWN-P — system REBOOTED on shutdown -p (reboot_flags not honored, nextbsd#398)"
        catch { close }
        catch { wait }
        exit 1
    }
    -re $re_poweroff {
        puts "\nOK: SHUTDOWN-P-OK — launchd honored the init poweroff protocol (shutdown -p -> SIGUSR2 -> RB_HALT|RB_POWEROFF)"
        # The banner means the shutdown sequence STARTED; the gate is the VM
        # actually going away. A banner with no qemu exit within the budget is
        # the nextbsd#503 class (shutdown returned, system wedged) and is now
        # a hard FAIL -- previously an informational WARN that shipped a stuck
        # VM green.
        expect {
            timeout {
                puts "\nFAIL: SHUTDOWN-P — poweroff banner seen but qemu did not exit within 180s (nextbsd#503); forcing halt -p"
                send "\r"
                sleep 1
                send "r halt -p\r"
                expect { timeout {} eof {} "Uptime:" {} }
                catch { close }
                catch { wait }
                exit 1
            }
            eof { puts "\nOK: VM exited after poweroff" }
        }
    }
    eof {
        # Poweroff paths without a console banner (e.g. arm64 PSCI) go straight
        # to qemu exit. "Rebooting..." is always printed on the reboot path
        # (kern_shutdown.c), so a silent exit here is a poweroff.
        puts "\nOK: SHUTDOWN-P-OK — VM exited on shutdown -p (bannerless poweroff path)"
    }
}

# A clean poweroff hits eof, which auto-closes the spawn — an explicit `close`
# then throws "spawn id ... not open" and (uncaught) fails an otherwise-passing
# boot. Guard both so teardown never turns a green boot red. (nextbsd#369)
catch { close }
catch { wait }
