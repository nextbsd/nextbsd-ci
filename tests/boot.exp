set nb_pol(TASK-SPECIAL-PORT) "must-pass"
set nb_reason(TASK-SPECIAL-PORT) "pending T3 audit; live arms: monolith t=fail/f=fail/s=continue ; fork t=fail/f=fail/s=continue"
