                exp_continue
            }
            set nb_wfail($m) 1
            puts "\nWARN: $m-FAIL — $r (informational)"
            exp_continue
        }
        if {$sfx eq "SKIP"} {
            if {$pol eq "must-pass"} {
                puts "\nFAIL: $m-SKIP — a must-pass capability self-skipped (absent from this image)"
                exit 1
            }
            set nb_seen($m) 1
            puts "\nWARN: $m-SKIP — $r"
            exp_continue
        }
    }
    -re $re_marker_fail {
        set m $expect_out(1,string)
        set sfx FAIL
        if {![info exists nb_pol($m)]} { if {$env(NB_DEBUG) ne ""} { puts "\nDBG-ARM: unlisted marker <$m>-$sfx — ignoring" }; exp_continue }
        set pol $nb_pol($m)
        set r   $nb_reason($m)
        if {$sfx eq "OK"} {
            set nb_seen($m) 1
            puts "\nOK: $m"
            exp_continue
        }
        if {$sfx eq "FAIL"} {
            if {$pol eq "must-pass" || $pol eq "fail-gates"} {
